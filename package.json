{
  "name": "chain-chapters",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/chrome": "0.2.8",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "esbuild": "0.28.2",
    "vitest": "4.1.11"
  }
}
